<section class="mist-eco-project-form">
	<div class="form-group">
		<label>{{localize "MIST_ECO.Project.Name"}}</label>
		<div class="form-fields">
			<input type="text" name="name" value="{{project.name}}" required>
		</div>
	</div>
	<div class="form-group">
		<label>{{localize "MIST_ECO.Project.Image"}}</label>
		<div class="form-fields">
			<file-picker name="img" type="image" value="{{project.img}}"></file-picker>
		</div>
	</div>
	<div class="form-group">
		<label>{{localize "MIST_ECO.Organization.Label"}}</label>
		<div class="form-fields">
			<select name="organization">
				{{#each organizations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
			</select>
		</div>
		<p class="hint">{{localize "MIST_ECO.Organization.ProjectHint"}}</p>
	</div>
	<div class="form-group">
		<label>{{localize "MIST_ECO.Organization.Allies"}}</label>
		<div class="form-fields">
			<select name="allies" multiple size="5">
				{{#each allies}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
			</select>
		</div>
		<p class="hint">{{localize "MIST_ECO.Organization.AlliesHint"}}</p>
	</div>
	<div class="form-group">
		<label>{{localize "MIST_ECO.Influence.Weight"}}</label>
		<div class="form-fields">
			<input type="number" name="influence" value="{{project.influence}}" min="0" step="1">
		</div>
		<p class="hint">{{localize "MIST_ECO.Influence.WeightHint"}}</p>
	</div>
	<div class="form-group">
		<label>{{localize "MIST_ECO.Project.Status"}}</label>
		<div class="form-fields">
			<select name="status">
				{{#each statuses}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
			</select>
		</div>
	</div>

	<fieldset>
		<legend>{{localize "MIST_ECO.Project.Work"}}</legend>
		<div class="form-group">
			<label>{{localize "MIST_ECO.Project.Days"}}</label>
			<div class="form-fields">
				<input type="number" name="days" value="{{project.days}}" min="0" step="1">
			</div>
			<p class="hint">{{localize "MIST_ECO.Project.DaysHint"}}</p>
		</div>
		<div class="form-group">
			<label>{{localize "MIST_ECO.Project.Progress"}}</label>
			<div class="form-fields">
				<input type="number" name="progress" value="{{project.progress}}" min="0" step="1">
			</div>
		</div>
		<div class="form-group">
			<label>{{localize "MIST_ECO.Project.KindLabel"}}</label>
			<div class="form-fields">
				<select name="kind">
					{{#each kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
				</select>
			</div>
			<p class="hint">{{localize "MIST_ECO.Project.KindsHint"}}</p>
		</div>
		<div class="form-group">
			<label>{{localize "MIST_ECO.Project.Workers"}}</label>
			<div class="form-fields">
				<input type="number" name="workers" value="{{project.workers}}" min="0" step="1">
			</div>
		</div>
	</fieldset>

	<fieldset>
		<legend>{{localize "MIST_ECO.Project.Cost"}}</legend>
		<p class="hint">{{localize "MIST_ECO.Project.CostHint"}}</p>
		{{#each costs}}
		<div class="form-group">
			<label>{{label}}</label>
			<div class="form-fields">
				<input type="number" name="cost.{{key}}" value="{{value}}" min="0" step="1">
			</div>
		</div>
		{{/each}}
	</fieldset>

	<fieldset class="mist-eco-grants">
		<legend>{{localize "MIST_ECO.Features.Grants"}}</legend>
		<p class="hint">{{localize "MIST_ECO.Features.GrantsHint"}}</p>
		{{#each grants}}
		<div class="mist-eco-grant">
			<img src="{{img}}" alt="">
			<input type="hidden" name="grants.{{index}}.img" value="{{img}}">
			<input type="hidden" name="grants.{{index}}.uuid" value="{{uuid}}">
			{{#if linked}}
			<span class="linked" data-tooltip="MIST_ECO.Features.LinkedHint"><i class="fa-solid fa-link" inert></i> {{name}}<input type="hidden" name="grants.{{index}}.name" value="{{name}}"></span>
			{{else}}
			<input type="text" name="grants.{{index}}.name" value="{{name}}" placeholder="{{localize "MIST_ECO.Features.Name"}}">
			{{/if}}
			<select name="grants.{{index}}.target">
				{{#each targets}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
			</select>
			<button type="button" class="icon fa-solid fa-trash" data-action="removeGrant" data-index="{{index}}" data-tooltip="MIST_ECO.Features.Delete"></button>
			{{#if linked}}
			<button type="button" class="unlink" data-action="unlinkGrant" data-index="{{index}}"><i class="fa-solid fa-link-slash" inert></i> {{localize "MIST_ECO.Features.Unlink"}}</button>
			{{else}}
			<textarea name="grants.{{index}}.description" rows="2" placeholder="{{localize "MIST_ECO.Features.DescriptionHint"}}">{{description}}</textarea>
			{{/if}}
			<div class="mist-eco-grant-resources">
				{{#unless editable}}<p class="hint">{{localize "MIST_ECO.Features.ReadOnly"}}</p>{{/unless}}
				<span class="label">{{localize "MIST_ECO.Features.Gives"}}</span>
				{{#each gives}}
				<span class="mist-eco-resource-row">
					<select name="grants.{{../index}}.gives.{{index}}.key" {{#unless ../editable}}disabled{{/unless}}>
						{{#each keys}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
					</select>
					<input type="number" name="grants.{{../index}}.gives.{{index}}.amount" value="{{amount}}" step="1" {{#unless ../editable}}disabled{{/unless}}>
					{{#if ../editable}}<button type="button" class="icon fa-solid fa-xmark" data-action="removeResource" data-index="{{../index}}" data-list="gives" data-row="{{index}}" data-tooltip="MIST_ECO.Features.RemoveResource"></button>{{/if}}
				</span>
				{{/each}}
				{{#if editable}}<button type="button" data-action="addResource" data-index="{{index}}" data-list="gives"><i class="fa-solid fa-plus" inert></i> {{localize "MIST_ECO.Features.AddGives"}}</button>{{/if}}
				<span class="label">{{localize "MIST_ECO.Features.Needs"}}</span>
				{{#each needs}}
				<span class="mist-eco-resource-row">
					<select name="grants.{{../index}}.needs.{{index}}.key" {{#unless ../editable}}disabled{{/unless}}>
						{{#each keys}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
					</select>
					<input type="number" name="grants.{{../index}}.needs.{{index}}.amount" value="{{amount}}" min="0" step="1" {{#unless ../editable}}disabled{{/unless}}>
					{{#if ../editable}}<button type="button" class="icon fa-solid fa-xmark" data-action="removeResource" data-index="{{../index}}" data-list="needs" data-row="{{index}}" data-tooltip="MIST_ECO.Features.RemoveResource"></button>{{/if}}
				</span>
				{{/each}}
				{{#if editable}}<button type="button" data-action="addResource" data-index="{{index}}" data-list="needs"><i class="fa-solid fa-plus" inert></i> {{localize "MIST_ECO.Features.AddNeeds"}}</button>{{/if}}
			</div>
		</div>
		{{/each}}
		<button type="button" data-action="addGrant"><i class="fa-solid fa-plus" inert></i> {{localize "MIST_ECO.Features.AddGrant"}}</button>
	</fieldset>

	{{#if others.length}}
	<fieldset>
		<legend>{{localize "MIST_ECO.Project.Unlocks"}}</legend>
		<p class="hint">{{localize "MIST_ECO.Project.UnlocksHint"}}</p>
		<div class="mist-eco-unlocks">
			{{#each others}}
			<label><input type="checkbox" name="unlocks.{{id}}" {{#if checked}}checked{{/if}}> {{name}} <span class="hint">({{status}})</span></label>
			{{/each}}
		</div>
	</fieldset>
	{{/if}}

	<fieldset class="mist-eco-description">
		<legend>{{localize "MIST_ECO.Project.Description"}}</legend>
		<prose-mirror name="description" value="{{project.description}}" toggled="true">{{{enrichedDescription}}}</prose-mirror>
	</fieldset>
</section>
